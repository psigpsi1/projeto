rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado()  { return request.auth != null; }
    function mail()    { return request.auth.token.email.lower(); }
    function ehAdmin() {
      return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Permitir que o próprio utilizador leia o seu registo na whitelist para validação
    match /authorized-users/{id} {
      allow read: if logado() && id == mail();
      allow write: if false;
    }

    match /admins/{id} { allow read, write: if false; }

    function autorizado() {
      return logado()
        && exists(/databases/$(database)/documents/authorized-users/$(mail()))
        && get(/databases/$(database)/documents/authorized-users/$(mail())).data.active == true;
    }

    match /requisicoes/{id} {
      allow read: if ehAdmin() || (autorizado() && resource.data.uid == request.auth.uid);

      allow create: if autorizado()
        && request.resource.data.keys().hasOnly(['codigo','uid','requisitante','email','equipamento',
             'dataPedido','devolucaoPrevista','estado','observacoes','criadoEm'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == mail()
        && request.resource.data.estado == 'Pendente'
        && request.resource.data.equipamento in ['Portátil01','Portátil02','Tablet01','Tablet02','Projetor01']
        && request.resource.data.dataPedido is string
        && request.resource.data.devolucaoPrevista is string
        && request.resource.data.devolucaoPrevista >= request.resource.data.dataPedido
        && request.resource.data.observacoes.size() <= 500
        && request.resource.data.criadoEm == request.time;

      allow update, delete: if ehAdmin();
    }
  }
}
